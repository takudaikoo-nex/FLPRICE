{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-flower",
    "dist-tasks",
    "supabase/functions/send-order-mail",
    "supabase/functions/task-public",
    "supabase/functions/flower-public",
    "supabase/functions/stripe-webhook",
    "supabase/functions/_shared/smtp.ts",
    "supabase/functions/_shared/orderMails.ts"
  ]
}